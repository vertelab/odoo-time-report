<odoo>
  <data>
    <record id="time_report_calendar" model="ir.ui.view">
          <field name="name">time.report.calendar</field>
          <field name="model">account.analytic.line</field>
          <field name="arch" type="xml">
            <calendar string="Time Report" date_start="date" date_delay="unit_amount" color="account_id" create="False" delete="False">   <!-- edit="false" -->
                  <field name="project_id" attrs="{'invisible': [('project_id', '=', False)]}" />
                  <field name="task_id" attrs="{'invisible': [('task_id', '=', False)]}"/>
                  <field name="unit_amount" string="Duration" attrs="{'invisible': [('unit_amount', '=', False)]}"/>
                  <field name="name" attrs="{'invisible': [('name', '=', False)]}"/>
              </calendar>
          </field>
      </record>

  </data>
</odoo>